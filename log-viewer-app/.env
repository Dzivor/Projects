PORT = 3000
NODE_ENV = development

DB_USER=your_readonly_db_user
DB_PASSWORD=your_db_password
DB_SERVER=your_sql_server_address
DB_NAME =your_database_name


LDAP_URL= ldap://your_ldap_server_address
LDAP_BASE_DN= your_ldap_base_dn 
LDAP_SERVICE_ACCOUNT=CN=AppService, DC=yourcompany, DC=com
LDAP_SERVICE_PASSWORD=your_service_account_password


JWT_SECRET = replace_this_with_a_very_long_random_string
JWT_EXPIRES_IN = 30m.